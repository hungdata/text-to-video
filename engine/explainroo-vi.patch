+++ b/src/align.js
@@ -225,3 +225,56 @@ export function alignWords(words, heard, duration) {
   const counted = tokens.filter((t) => !t.optional).length;
   return { words: out, matchRate: counted ? Math.min(1, matched / counted) : 1 };
 }
+
+// Vietnamese: the voice service tells us when each word starts, so we only
+// have to pair its words with ours. Words are compared syllable by syllable
+// after NFC normalization, keeping the tone marks (no English number rules).
+const viNorm = (s) => String(s).normalize('NFC').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
+
+export function alignVi(words, boundaries, duration) {
+  const heard = [];
+  for (const b of boundaries) {
+    const syl = viNorm(b.text).split(/\s+/).filter(Boolean);
+    const step = (b.end - b.start) / Math.max(1, syl.length);
+    syl.forEach((t, i) => heard.push({ t, start: b.start + i * step, end: b.start + (i + 1) * step }));
+  }
+  let j = 0;
+  let matchedSyl = 0;
+  let totalSyl = 0;
+  const out = words.map((w) => {
+    const syl = viNorm(w.spoken).split(/\s+/).filter(Boolean);
+    let start = null;
+    let end = null;
+    let hit = 0;
+    for (const t of syl) {
+      totalSyl++;
+      let k = -1;
+      for (let d = 0; d < 4 && j + d < heard.length; d++) if (heard[j + d].t === t) { k = j + d; break; }
+      if (k < 0) continue;
+      if (start === null) start = heard[k].start;
+      end = heard[k].end;
+      j = k + 1;
+      hit++;
+      matchedSyl++;
+    }
+    return { start, end, matched: syl.length > 0 && hit === syl.length };
+  });
+  // Words we could not pair get the gap between their neighbours.
+  for (let i = 0; i < out.length; i++) {
+    if (out[i].start !== null) continue;
+    let a = i - 1;
+    while (a >= 0 && out[a].start === null) a--;
+    let b = i + 1;
+    while (b < out.length && out[b].start === null) b++;
+    const from = a >= 0 ? out[a].end : 0;
+    const to = b < out.length ? out[b].start : duration;
+    const n = b - a - 1;
+    for (let k = a + 1; k < b; k++) {
+      const p = (k - a - 1) / n;
+      out[k].start = from + (to - from) * p;
+      out[k].end = from + (to - from) * (p + 1 / n);
+    }
+    i = b - 1;
+  }
+  return { words: out, matchRate: totalSyl ? matchedSyl / totalSyl : 1 };
+}
